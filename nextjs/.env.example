# Metabsp Next.js app — stateless Cloud API slice only.
# See docs/NEXTJS_MIGRATION_AUDIT_AND_PLAN.md §1.9 for the full variable
# audit and §2 for the hybrid-architecture rationale. This app shares the
# SAME MongoDB Atlas cluster and the SAME Redis instance as the always-on
# backend/ host — no separate data store, no dual-write.

# ── Core datastores (same values as backend/.env on the always-on host) ──
MONGO_URI=
REDIS_URL=
REDIS_CLUSTER_NODES=

# ── Auth (must match the always-on host's values — same JWT secret, same
#    users, since both apps read/write the same `users` collection) ──
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── WhatsApp Cloud API ──
META_APP_ID=
META_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ENFORCE_WEBHOOK_SIGNATURE=true
WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_TOKEN_ENCRYPTION_KEY_PREVIOUS=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_OTP_TEMPLATE_NAME=instify_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# ── Cloudinary (server-side signed uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional features ──
ANTHROPIC_API_KEY=
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
SENTRY_DSN=
LOG_LEVEL=info

# ── Frontend origin (CORS for any external caller; same-origin calls from
#    this app's own pages don't need this) ──
FRONTEND_URL=
