# MetaBSP — every environment variable the application reads.
#
# This is now the only .env in the repository: the Express backend and the
# Vite frontend that each had their own are gone, and one process serves the
# dashboard, the API, the Meta webhook, Socket.IO and the background workers.
#
# scripts/meta-deploy-check.js enforces the required ones at deploy time, so a
# deployment missing a critical value fails its build rather than starting up
# and failing silently at Meta's webhook.

# ─────────────────────────────────────────────────────────────────────────────
# Datastores — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
MONGO_URI=
REDIS_URL=
# Only for a Redis Cluster deployment; leave empty for a single instance.
REDIS_CLUSTER_NODES=

# ─────────────────────────────────────────────────────────────────────────────
# Sessions — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# Signs dashboard session tokens AND authenticates websocket handshakes.
JWT_SECRET=
# Honoured as written. It previously was not — the code hardcoded 99 days
# regardless of this value.
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# Public origin
# ─────────────────────────────────────────────────────────────────────────────
# The canonical public URL, e.g. https://app.example.com — used in outbound
# links and as the default CORS/websocket origin.
FRONTEND_URL=
# Comma-separated extra origins allowed to call the dashboard API and open a
# websocket. Leave empty for a single-origin deployment, which is the normal
# case. Does not affect /api/v1, which is open to any origin by design (an
# API key cannot be attached by a browser automatically).
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Meta / WhatsApp Cloud API — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_API_VERSION=v23.0
META_API_VERSION=v23.0
META_ES_VERSION=v4

# Coexistence: the WhatsApp Business app and the Cloud API on one number.
# Keep false until the `history`, `smb_message_echoes` and `smb_app_state_sync`
# webhook fields are subscribed in the App Dashboard AND one real coexistence
# onboarding has been completed — otherwise the Embedded Signup popup offers a
# path whose traffic goes nowhere. See docs/meta-tech-provider/COEXISTENCE.md.
META_ENABLE_COEXISTENCE=false

# The string you enter in the App Dashboard's webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Never set this to false outside local development: it makes the webhook
# accept an unsigned payload from anyone who knows the URL.
WHATSAPP_ENFORCE_WEBHOOK_SIGNATURE=true

# Base64-encoded 32 bytes. Encrypts every stored customer access token.
# Changing it does not error — it silently fails to decrypt existing tokens
# and every connected number stops sending. To rotate, move the old value to
# _PREVIOUS and set a new one; both are tried on read.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_TOKEN_ENCRYPTION_KEY_PREVIOUS=

WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_TEMPLATE_NAME=instify_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Single-number fallback, used only before any account is connected through
# the dashboard. A normal multi-tenant deployment leaves these empty.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Media storage — REQUIRED for inbound media
# ─────────────────────────────────────────────────────────────────────────────
# Meta's media URLs expire, so inbound media is re-uploaded here. All uploads
# are signed server-side; there is no unsigned browser upload preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Background workers and schedulers
# ─────────────────────────────────────────────────────────────────────────────
# false makes an instance serve HTTP only. At least one instance in the
# deployment must have this true, or nothing consumes the send and webhook
# queues and no scheduled work runs.
RUN_BACKGROUND_JOBS=true
SEND_WORKER_CONCURRENCY=5
WEBHOOK_WORKER_CONCURRENCY=10

# A one-Graph-call audit of the Meta-side configuration at boot.
RUN_PREFLIGHT_ON_BOOT=true

# Pings registered customer webhook destinations so they do not cold-start.
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_URLS=
KEEP_ALIVE_TOKEN=

# Needs the `mongodump` binary and a real, persistent BACKUP_DIR mount.
ENABLE_SCHEDULED_BACKUPS=false
BACKUP_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# Data retention — OFF unless you set a window
# ─────────────────────────────────────────────────────────────────────────────
# docs/legal/DATA_RETENTION_POLICY.md is a commitment to your customers. These
# are what enforce it. Every one defaults to 0, meaning keep forever, because
# deleting message history is irreversible and the period is a legal decision,
# not something to inherit from a default.
#
# Set a number of days to enable. The sweep runs daily, in bounded batches.
RETENTION_MESSAGES_DAYS=0
RETENTION_CONTACTS_INACTIVE_DAYS=0
RETENTION_AUDIT_LOG_DAYS=0
# When a message is pruned, also delete its media file from Cloudinary.
# Leaving this false means the row goes and the file stays — deletion that is
# not really deletion.
RETENTION_DELETE_MEDIA=true

# ─────────────────────────────────────────────────────────────────────────────
# Billing — OFF unless configured
# ─────────────────────────────────────────────────────────────────────────────
# The Cashfree integration has NOT been verified against live Cashfree
# documentation (see lib/services/paymentGatewayService.ts). Leaving these
# empty makes self-service subscription return a clear 503 rather than
# half-working. Verify against a sandbox call before setting them.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────
# AI-assisted auto-reply suggestions.
ANTHROPIC_API_KEY=
SENTRY_DSN=
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# App Review
# ─────────────────────────────────────────────────────────────────────────────
# Set META_REVIEW_ENFORCE_READY=true on the exact deployment submitted to
# Meta: the deploy gate then requires the reviewer credentials below, so a
# submission cannot go out with a login the reviewer cannot use.
META_REVIEW_ENFORCE_READY=false
META_REVIEWER_LOGIN=
META_REVIEWER_PASSWORD=
META_REVIEW_CONTACT_EMAIL=
