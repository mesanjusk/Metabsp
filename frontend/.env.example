# WhatsApp Cloud BSP (Metabsp)
VITE_API_LOCAL=http://localhost:5000
VITE_API_SERVER=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com

# Bulk-invite (Event Management) — must point at the /api/bulk prefix
VITE_API_URL=https://your-backend.onrender.com/api/bulk

# Cloudinary (used by Bulk-invite uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── Meta App Review reviewer access (/meta-app-review) ──
# Set these in Vercel, never in git: this repository is public, and a working
# login committed to it is a credential leak. When unset, the page tells the
# reviewer the credentials are in the App Review submission instead.
# See docs/meta-tech-provider/APP_REVIEW_SUBMISSION_TEXT.md.
VITE_PUBLIC_APP_URL=https://meta.sanjusk.in
VITE_REVIEWER_LOGIN=
VITE_REVIEWER_PASSWORD=
VITE_REVIEWER_TEST_NUMBER=

# Facebook App Data Deletion callback, as registered in the Meta App Dashboard.
# Defaults to <VITE_PUBLIC_APP_URL>/data-deletion. Set explicitly only if the
# callback is served from a different host than the app.
VITE_DATA_DELETION_CALLBACK_URL=

# ── Public contact addresses ──
# Every public page (Privacy Policy, Terms, Cookie Policy, Security, Contact,
# Help Centre, the footer, the App Review page) reads these from
# frontend/src/config/publicSite.js. Left blank, each one defaults to
# <role>@<the host in VITE_PUBLIC_APP_URL>.
#
# Set them only if a mailbox lives somewhere else. Either way, confirm every
# address actually receives mail before submitting: Meta's reviewers read the
# legal pages, and an address that bounces is worse than no address at all.
VITE_SUPPORT_EMAIL=
VITE_SALES_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_SECURITY_EMAIL=
VITE_LEGAL_EMAIL=
VITE_REVIEW_EMAIL=
