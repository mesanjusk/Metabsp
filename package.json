{
  "name": "metabsp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm test --workspace=frontend && npm test --workspace=backend",
    "test:frontend": "npm test --workspace=frontend",
    "test:backend": "npm test --workspace=backend",
    "seed-reviewer": "npm run seed-reviewer --workspace=backend",
    "submission-check": "npm run submission-check --workspace=backend",
    "install:all": "npm install --workspace=frontend && npm install --workspace=backend"
  }
}
