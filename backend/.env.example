PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mis
FRONTEND_URL=http://localhost:5173

# Required for the broadcast send queue (src/queues/) and, later, the
# distributed rate limiter and BullMQ-backed background jobs.
REDIS_URL=redis://127.0.0.1:6379
# For a Redis Cluster deployment, set comma-separated "host:port" nodes here
# instead of (or in addition to) REDIS_URL — see src/config/redis.js.
# REDIS_CLUSTER_NODES=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379

# Hop count for Express's trust-proxy setting — 1 is correct for the common
# single-reverse-proxy deployment (Render, Railway, nginx in front of one
# app instance). Set to the exact number of proxy hops in front of this app,
# or 'false' if the app is directly internet-facing with no proxy.
TRUST_PROXY=1

# ── Scheduled backups (optional, off by default) ─────────────────────────────
# See src/services/backupSchedulerService.js and docs/BACKUP_RESTORE.md.
# Requires the `mongodump` binary (MongoDB Database Tools) on this host.
ENABLE_SCHEDULED_BACKUPS=false
BACKUP_DIR=./backups

# ── Auth (shared by every login path — Cloud and Bulk both use this) ────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# ACCESS_TOKEN_SECRET is a legacy alias for JWT_SECRET, read only if
# JWT_SECRET is unset. Set JWT_SECRET going forward.
# ACCESS_TOKEN_SECRET=replace_with_jwt_secret

# BOOTSTRAP_USERNAME/PASSWORD: optional env-configured super-admin login that
# upserts (and keeps in sync with) a real DB user on first use.
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_NAME=
# BOOTSTRAP_PASSWORD=

# SUPER_ADMIN_USERNAME/PASSWORD: set both to seed a super admin at boot.
# There is no default password — leaving these unset just skips seeding.
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_MOBILE=
# SUPER_ADMIN_PASSWORD=

# ── Meta / WhatsApp Cloud API ────────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# WHATSAPP_API_VERSION is the canonical name; META_API_VERSION is a legacy
# alias read as a fallback (see backend/src/config/graphApi.js).
WHATSAPP_API_VERSION=v20.0
META_API_TOKEN=your_permanent_system_user_access_token
# Facebook Login for Business configuration ID for the WhatsApp Embedded
# Signup flow (Meta App Dashboard -> WhatsApp -> Embedded Signup). Required
# for the "Connect" button's real Embedded Signup path; without it the UI
# tells the user to use "Connect manually" instead.
META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_config_id
# Coexistence: lets a customer keep using the WhatsApp Business app on the
# same number this platform sends from. Defaults to enabled. Set to false
# until the `history`, `smb_message_echoes` and `smb_app_state_sync` webhook
# fields are subscribed in the Meta App Dashboard — otherwise a coexistence
# number onboards fine and then never delivers history, echoes, or contacts.
# See docs/meta-tech-provider/COEXISTENCE.md.
META_ENABLE_COEXISTENCE=true
# ── Social sign-in (optional, additive to username/password login) ──────────
# Each provider stays hidden on the login page until configured, so leaving
# these blank keeps today's login exactly as it is.
# Google: create an OAuth 2.0 Web client and add your app origin to
# "Authorised JavaScript origins". Only the client ID is needed — ID tokens are
# verified against Google's tokeninfo endpoint, not exchanged.
GOOGLE_CLIENT_ID=
# Facebook sign-in is OFF unless both of these are set. It does not inherit
# META_APP_ID/META_APP_SECRET: having a Meta app for WhatsApp is not the same
# as having consumer Facebook Login enabled on it. Embedded Signup uses
# "Facebook Login for Business" (via config_id); user sign-in uses ordinary
# "Facebook Login", a separate product you must add in the App Dashboard first
# — otherwise the dialog fails with "This app needs at least one supported
# permission". To use the same app for both, set FACEBOOK_APP_ID to the same
# value as META_APP_ID after adding that product.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Scopes the login dialog requests. `public_profile` is granted to every Meta
# app; `email` is NOT — it needs the "Authentication and account creation" use
# case added in the App Dashboard first. Requesting a scope the app lacks
# fails the whole dialog with "Invalid Scopes: email". Add email here only
# after enabling it, since without an email address Facebook sign-in can never
# link to an existing account and always creates a new one.
FACEBOOK_LOGIN_SCOPES=public_profile

WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_ENFORCE_WEBHOOK_SIGNATURE=true
WHATSAPP_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Set only while rotating the key above — move the old key's value here
# first, deploy, then eventually drop this once nothing needs it anymore.
# See src/utils/crypto.js.
# WHATSAPP_TOKEN_ENCRYPTION_KEY_PREVIOUS=base64_encoded_32_byte_key
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Shared/legacy env-config WhatsApp number, used only for platform-sent OTPs
# (not per-user messaging — see src/services/otpService.js).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Cloudinary (media uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Billing (UPI Autopay via Cashfree) ───────────────────────────────────────
# See src/services/paymentGatewayService.js — verify field names/signature
# scheme against Cashfree's current docs before enabling in production.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01

# ── AI chatbot auto-reply (optional) ─────────────────────────────────────────
# Required only for AutoReply rules with ruleType: 'ai_assistant'.
# See src/services/aiChatbotService.js.
ANTHROPIC_API_KEY=

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Leave blank to disable — see src/instrument.js. Error tracking/APM via Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
